# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (Prisma, pointed at Supabase Postgres)
# DATABASE_URL: pooled connection via Supabase's pgbouncer (port 6543) — used by the running app.
#   Get this from Supabase dashboard > Project Settings > Database > Connection string > "Transaction" mode.
# DIRECT_URL: direct connection (port 5432) — used only for `prisma migrate`.
#   Same dashboard page, "Session" mode / "Direct connection".
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Staff/admin session tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Firebase Admin (customer auth) — paste values from your service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email (Nodemailer) — leave blank to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ticketing System <no-reply@example.com>"

# SMS (Twilio) — leave blank to skip sending SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push (Firebase Cloud Messaging) reuses the FIREBASE_* credentials above

# Payments — leave blank to run in sandbox/stub mode (payment.service.ts records a
# PENDING payment and returns instructions instead of calling the real API).
#
# Each provider also has a *_WEBHOOK_SECRET (or FLUTTERWAVE_SECRET_HASH), used by
# POST /api/payments/webhook/:provider to verify an inbound payment notification
# really came from that provider before flipping PENDING -> SUCCESS. Leave webhook
# secrets blank and that provider's webhook route always rejects (fails closed) —
# use POST /api/payments/:id/confirm-sandbox during local dev instead.
MTN_MOMO_API_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENV=sandbox
MTN_MOMO_WEBHOOK_SECRET=

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe dashboard's webhook endpoint config (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "secret hash" you set in the Flutterwave dashboard's webhook config.
FLUTTERWAVE_SECRET_HASH=

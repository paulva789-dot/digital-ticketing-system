# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/ticketing?schema=public"

# Staff/admin session tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Firebase Admin (customer auth) — paste values from your service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email (Nodemailer) — leave blank to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ticketing System <no-reply@example.com>"

# SMS (Twilio) — leave blank to skip sending SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push (Firebase Cloud Messaging) reuses the FIREBASE_* credentials above
